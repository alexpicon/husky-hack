# Copy to app/.env.local for `npm run dev` and `npm run skipper:eval`, and set the
# same names in Vercel (Project > Settings > Environment Variables) for the live demo.
# app/.env.local is gitignored. Never give a secret a VITE_ prefix: Vite would ship
# it to the browser.

# Skipper's AI path (api/skipper.ts). Server-side only.
ANTHROPIC_API_KEY=
# Stays "off" (keyword matching) until `npm run skipper:eval` passes; then "on".
SKIPPER_AI=off
SKIPPER_MODEL=claude-haiku-4-5

# Upstash Redis for shared sessions and the panel wall (api/session.ts, api/panel.ts).
# Vercel's Upstash integration sets these for you; any prefix ending in
# KV_REST_API_URL / KV_REST_API_TOKEN also works. Without them, the functions keep
# state in memory and sessions are unreliable. Local dev always uses memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
